<style is:inline>
	toggle-tabs > ul {
		list-style-type: none;
		display: flex;
		gap: 1ch;
		padding: 0;
		border-block-end: thin solid var(--h-color);
		anchor-name: --toggle-tabs-selector;
		> li {
			flex: 1 1 0%;
			> a {
				padding: 1rem;
				background: var(--mg-color);
				border-radius: 1rem 1rem 0 0;
				text-decoration: none;
				color: currentColor;
				display: block;
				text-align: center;
			}
		}
	}
	[aria-selected='true'] {
		background: var(--h-color);
		/* color: var(--bg-color); */
	}
	[role='tabpanel'] {
		display: none;

		&.is-visible {
			display: block;
		}
	}
	@supports (position-anchor: --a) {
		[role='tabpanel'] {
			position: absolute;
			position-anchor: --toggle-tabs-selector;
			top: calc(anchor(bottom) + 10px);
			left: anchor(left);
			right: anchor(right);
			opacity: 0;
			filter: brightness(50%) blur(5px);
			transition-property: all;
			transition-duration: 200ms;
			transition-behavior: allow-discrete;
			&.is-visible {
				opacity: 1;
				filter: brightness(100%);
				@starting-style {
					opacity: 0;
					filter: brightness(50%) blur(5px);
				}
			}
		}
	}
</style>

<toggle-tabs><slot /></toggle-tabs>
<script is:inline>
	customElements.define(
		'toggle-tabs',
		class extends HTMLElement {
			/**
			 * Instantiate the Web Component
			 */
			constructor() {
				// Get parent class properties
				super();
			}

			connectedCallback() {
				console.log('toggle-tabs connected!');
				// Only run if there are tabs
				this.tabList = this.querySelector('ul');
				if (!this.tabList) return;

				// Get the list items and links
				const tabs = this.querySelectorAll('div');
				const listItems = this.tabList.querySelectorAll('li');
				const links = this.tabList.querySelectorAll('a');

				tabs[0].classList.toggle('is-visible');

				// Add ARIA to list
				this.tabList.setAttribute('role', 'tablist');

				// Add ARIA to the list items
				for (let item of listItems) {
					item.setAttribute('role', 'presentation');
				}

				for (let tab of tabs) {
					tab.setAttribute('role', 'tab');
				}
				// Add ARIA to the links and content
				let instance = this;
				links.forEach(function (link, index) {
					// Get the the target element
					let tabPane = instance.querySelector(link.hash);
					if (!tabPane) return;

					// Add [role] and [aria-selected] attributes
					link.setAttribute('role', 'tab');
					link.setAttribute(
						'aria-selected',
						index === 0 ? true : false,
					);

					// If it's not the active (first) tab, remove focus
					if (index > 0) {
						link.setAttribute('tabindex', -1);
					}

					// If there's no ID, add one
					if (!link.id) {
						link.id = `tab_${tabPane.id}`;
					}

					// Add ARIA to tab pane
					tabPane.setAttribute('role', 'tabpanel');
					tabPane.setAttribute('aria-labelledby', link.id);
				});

				// Listen for events
				this.tabList.addEventListener('click', this);
				document.addEventListener('keydown', this);
			}

			/**
			 * Handle events on the Web Component
			 * @param  {Event} event The event object
			 */
			handleEvent(event) {
				this[`on${event.type}`](event);
			}

			/**
			 * Handle click events
			 * @param  {Event} event The event object
			 */
			onclick(event) {
				// Only run on tab links
				if (!event.target.matches('[role="tab"]')) return;

				// Prevent the link from updating the URL
				event.preventDefault();

				// Ignore the currently active tab
				if (event.target.matches('[aria-selected="true"]')) return;

				// Toggle tab visibility
				this.toggle(event.target);
			}

			/**
			 * Handle keydown events
			 * @param  {Event} event The event object
			 */
			onkeydown(event) {
				// Only run for left and right arrow keys
				if (!['ArrowLeft', 'ArrowRight'].includes(event.code)) return;

				// Only run if element in focus is on a tab
				let tab = document.activeElement.closest('[role="tab"]');
				if (!tab) return;

				// Only run if focused tab is in this component
				if (!this.tabList.contains(tab)) return;

				// Get the currently active tab
				let currentTab = this.tabList.querySelector(
					'[role="tab"][aria-selected="true"]',
				);

				// Get the parent list item
				let listItem = currentTab.closest('li');

				// If right arrow, get the next sibling
				// Otherwise, get the previous
				let nextListItem =
					event.code === 'ArrowRight' ?
						listItem.nextElementSibling
					:	listItem.previousElementSibling;
				if (!nextListItem) return;
				let nextTab = nextListItem.querySelector('a');

				// Toggle tab visibility
				this.toggle(nextTab);
				nextTab.focus();
			}

			/**
			 * Toggle tab visibility
			 * @param  {Node} tab The tab to show
			 */
			toggle(newTab) {
				// Get the target tab pane
				let newPane = this.querySelector(newTab.hash);
				if (!newPane) return;

				// Get the current tab and content
				let oldTab = newTab
					.closest('[role="tablist"]')
					.querySelector('[aria-selected="true"]');
				let oldPane = document.querySelector(oldTab.hash);

				oldTab.setAttribute('aria-selected', false);
				oldTab.removeAttribute('tabindex');
				oldPane.classList.toggle('is-visible');

				newTab.setAttribute('aria-selected', true);
				newTab.setAttribute('tabindex', -1);
				newPane.classList.toggle('is-visible');
			}
		},
	);
</script>
